{
  "name": "stop-fraud-thunderbird",
  "version": "1.0.0",
  "description": "Stop fraudulent email in Thunderbird",
  "author": "AG",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "lint": "web-ext lint",
    "build": "esbuild background.js config.js manifest.json popup.js --bundle --platform=browser --outdir=dist/ && cp -r *.html manifest.json dist/",
    "start": "web-ext run --target=thunderbird",
    "format": "prettier --write \"**/*.{js,html,json,md}\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.53",
    "ai": "^7.0.119",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
