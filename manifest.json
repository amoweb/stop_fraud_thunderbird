{
    "manifest_version": 3,
    "version": "1.1",
    "author": "Amaury Graillat",
    "name": "__MSG_extensionName__",
    "default_locale": "en",
    "homepage_url": "https://github.com/amoweb/stop_fraud_thunderbird",
    "developer": {
        "name": "Amaury Graillat",
        "url": "https://amoweb.fr"
    },
    "icons": {
        "16": "res/icon.png",
        "32": "res/icon.png",
        "64": "res/icon.png",
        "128": "res/icon.png",
        "256": "res/icon.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "stopfraud@extensions.amoweb.fr",
            "strict_min_version": "128.0"
        }
    },
    "action": {
        "default_icon": "res/icon.png",
        "default_title": "__MSG_menuAnalyse__"
    },
    "background": {
        "scripts": ["background.js"],
        "type": "module"
    },
    "permissions": ["messagesRead", "storage", "scripting"],
    "host_permissions": [
        "https://api.anthropic.com/*",
        "https://api.openai.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.x.ai/*",
        "https://api.groq.com/*",
        "https://api.deepseek.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://api.lyceum.technology/*",
        "https://api.scaleway.ai/*",
        "https://eu.api.ovh.com/"
    ],

    "options_ui": {
        "page": "config.html",
        "open_in_tab": false,
        "browser_style": false
    },

    "message_display_action": {
        "default_icon": "res/icon.png",
        "default_title": "__MSG_menuAnalyse__"
    }
}
